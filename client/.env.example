# Copy to ".env" (local) or set these in Netlify -> Site settings -> Environment variables.

# Address of the backend server. Local: http://localhost:4000. After deploy: your Render URL (no trailing slash).
VITE_API_URL=http://localhost:4000

# Google OAuth "Client ID" (Web). Leave empty while testing with the dev login.
VITE_GOOGLE_CLIENT_ID=

# "true" = show the DEV login box (works only if the server has AUTH_PROVIDER=mock). Must be "false" when live.
VITE_AUTH_MOCK=true
