# Copy to ".env" (local). For the live site, pass the same two values when you run: bash scripts/publish-pages.sh
# Both values are PUBLIC by design (Supabase Dashboard -> Project Settings -> API Keys -> "Publishable key").
# NEVER put the secret / service_role key in the client.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
