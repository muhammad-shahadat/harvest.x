# ---- Copy this file to ".env" and fill the values. NEVER commit ".env". ----

NODE_ENV=development
PORT=4000

# Neon connection string (copy from Neon dashboard -> Connection string). Paste it as-is.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Any long random text. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-text

# 64 hex characters. Generate with the same command as above. DO NOT LOSE IT (farmer-card numbers are encrypted with it).
CARD_ENCRYPTION_KEY=

# "mock" = dev login without Google (only for local testing).  "google" = real Google Sign-In.
AUTH_PROVIDER=mock
GOOGLE_CLIENT_ID=

# Where the React app runs (used for CORS). Add your Netlify URL when you deploy.
CLIENT_URL=http://localhost:5173

# "mock" = save farmer-card photos in server/uploads (local testing only).
# "cloudinary" = save in Cloudinary (needed on Render, because Render's disk is temporary).
STORAGE_PROVIDER=mock
# Only for cloudinary: copy the "API environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL=
